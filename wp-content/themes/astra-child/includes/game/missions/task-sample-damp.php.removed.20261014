                'gain'  => ['clues' => ['ledger'], 'stage' => 's3_处置', 'stage_text' => '单据缺了两页'],
                'text'  => ['老周把台账摊开，手指停在跳号的那一页上。']],
        ],

        /* 任务期新人物：水道工老聂（上午/下午在 B3 水务间；任务善后即失去对话 ✓） */
        'newcomers' => [
            'tpl_nie' => ['name' => '老聂', 'role' => '水道工',
                'room' => 'b3_water', 'phases' => ['上午', '下午'], 'entry' => 'n1',
                'nodes' => [
                    'n1' => ['text' => ['「你也是来看那声响的？」老聂把手电往西墙上一照。',
                                        '「这管子二十年前铺的，我熟。」'],
                        'choices' => [
                            ['label' => '问他：西边这一段谁动过', 'goto' => 'n2'],
                            ['label' => '把潮气的走向说给他听', 'goto' => 'n3', 'cond' => ['flag' => 'clue_m_tpl_damp_wet']],
                            ['label' => '先不打扰他', 'goto' => 'end'],
                        ]],
                    'n2' => ['text' => ['他想了想：「上个月有个生面孔来借过工具，说是「修管子」。」',
                                        '「我问他哪个单位的，他没答。」'],
                        'choices' => [['label' => '（记下来）', 'goto' => 'end']],
                        'effect' => ['clue' => ['m_tpl_damp', 'patch']]],
                    'n3' => ['text' => ['他蹲下去摸了一把墙根：「这儿是回水，不是漏水。有人夜里放过水。」',
                                        '「放水要开总阀——总阀在后勤那儿锁着。」'],
                        'choices' => [['label' => '（记下来）', 'goto' => 'end']],
                        'effect' => ['clue' => ['m_tpl_damp', 'ledger']]],
                    'end' => ['text' => ['老聂把手电别回腰上，接着去巡管了。'], 'choices' => []],
