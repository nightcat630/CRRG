                            'choices' => [['label' => '（记下来）', 'goto' => 'end']],
                            'effect' => ['clue' => ['m_tpl_damp', 'ledger']]],
            ]],
        ],

        /* 任务期 NPC 时段移动：老周下午不在仓库，在西段现场（善后复原 ✓） */
        'actors' => [
            'zhou' => ['room' => 'b3_water', 'phases' => ['下午']],
        ],

        /* 载入节拍：玩家不动，局面也在变（幂等） */
        'beats' => [
            'spread' => ['when' => ['clues' => ['wet']],
                'do' => ['narrate' => ['（西段的潮痕比昨天宽了一掌——夜里又走过一次水。）'],
                         'fact' => 'base.西段返潮加重']],
            'ledger' => ['when' => ['concl' => 'src'],
                'do' => ['narrate' => ['（值班室把这条记进了本周的巡查重点。）'],
                         'stage' => 's3_处置']],
        ],

        'outcome' => ['done' => [
            'personal' => ['credits' => 6, 'money' => 150, 'rep' => ['base' => 2], 'flags' => ['damp_done']],
            'facts'    => [['base.西段水路查过了', true, 'once'], ['base.有人夜里用过水', true, 'once']],
            'actors'   => ['zhou' => ['fav' => 1], 'tpl_nie' => ['fav' => 1]],
            'world'    => ['note' => 'B3 西段的水路查清了：晚间有外人用过水。'],
            'archive'  => ['title' => '【任务档案】B3 返潮', 'type' => '事件', 'level' => 'operative'],
