 */
if (!defined('ABSPATH')) exit;

add_action('init', function () {
    if (!function_exists('crrg_task_define')) return;

    crrg_task_define('m_tpl_damp', [
        'name' => 'B3 返潮', 'level' => '低', 'kind' => 'base', 'min_lv' => 1,
