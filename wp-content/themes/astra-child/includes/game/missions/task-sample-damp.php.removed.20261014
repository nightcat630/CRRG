            'pry'   => ['name' => '撬开管卡看一眼', 'type' => 'brute', 'hp' => 1,
                'check' => ['skill' => '机械维修'],
                'cost'  => ['minutes' => 40, 'expose' => 1],
                'gain'  => ['clues' => ['patch'], 'stage' => 's2_查明', 'stage_text' => '看到了那处补丁'],
