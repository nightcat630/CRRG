            's3_处置' => ['name' => '处置', 'text' => '把这条线交给值班室'],
        ],

        /* 三线索规则：三条互相能印证，够 2 条就能立结论 ✓ */
        'clues' => [
            'wet'   => ['title' => '地面返潮的走向', 'point' => '潮气是从**西墙脚下**往外渗的，不是从天花板滴的。',
